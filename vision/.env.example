# Fast local OpenCV geometry/line detector is the default; no Roboflow key needed.
DETECTOR_PROVIDER=opencv
# Optional pretrained zero-shot detector; slow on CPU.
GROUNDING_DINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
GROUNDING_DINO_THRESHOLD=0.25
GROUNDING_DINO_TEXT_THRESHOLD=0.2
GROUNDING_DINO_IMAGE_SIZE=640
GROUNDING_DINO_CPU_THREADS=1

# Optional hosted provider: set DETECTOR_PROVIDER=roboflow to enable.
ROBOFLOW_API_KEY=replace-with-your-roboflow-private-api-key
ROBOFLOW_WORKFLOW_URL=
# Optional log label used by the hosted provider.
ROBOFLOW_MODEL_ID=boardsnap-workflow
ALLOW_DEMO_DETECTOR_FALLBACK=false

# Pretrained handwriting OCR model.
TROCR_MODEL_ID=microsoft/trocr-base-handwritten
